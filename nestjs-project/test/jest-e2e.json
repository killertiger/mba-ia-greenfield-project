{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "dotenv/config",
    "<rootDir>/setup-test-env.ts"
  ],
  "moduleNameMapper": {
    "^@css-inline/css-inline$": "<rootDir>/stubs/css-inline.stub.ts"
  }
}
